#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// --- Hotspot Setup ---
const char* ssid = "RC_Trash_Boat";
const char* password = "password123";

WebServer server(80);
Servo steeringServo;

// --- Pin Settings ---
#define SERVO_PIN      13
#define TRIG_PIN       12
#define ECHO_PIN       14

#define MOTOR_IN1      26
#define MOTOR_IN2      27
#define MOTOR_ENA      25 

#define MOTOR_IN3      32
#define MOTOR_IN4      33
#define MOTOR_ENB      18 

const int TANK_EMPTY_DIST = 30; 
const int TANK_FULL_DIST  = 5;  
const int motorSpeed = 200;     

// --- Web UI Stored in Flash Memory (Prevents Compile Lag) ---
const char HTML_PAGE[] PROGMEM = R"rawliteral(
<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width, initial-scale=1.0"><style>
body{font-family:Arial,sans-serif;text-align:center;background:#f4f7f6;margin:0;padding:20px;}
