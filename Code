.btn:active{background:#1976D2;}
.slider{width:80%;margin:20px 0;} .status{font-size:24px;font-weight:bold;color:#4CAF50;}
</style></head><body><div class="container"><h2>🚢 RC Boat Control</h2><div class="status">Trash Level: <span id="t">0</span>%</div><br>
<button class="btn" onmousedown="f('forward')" onmouseup="f('stop')" ontouchstart="f('forward')" ontouchend="f('stop')">▲</button><br>
<button class="btn" onmousedown="f('left')" onmouseup="f('stop')" ontouchstart="f('left')" ontouchend="f('stop')">◀</button>
<button class="btn" style="background:#f44336" onclick="f('stop')">■</button>
<button class="btn" onmousedown="f('right')" onmouseup="f('stop')" ontouchstart="f('right')" ontouchend="f('stop')">▶</button><br>
<button class="btn" onmousedown="f('backward')" onmouseup="f('stop')" ontouchstart="f('backward')" ontouchend="f('stop')">▼</button>
